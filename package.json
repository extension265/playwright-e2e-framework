{
  "name": "playwright-e2e-framework",
  "version": "1.0.0",
  "description": "Playwright test automation framework: page objects, API clients, custom fixtures, auth reuse, data-driven tests, tagging, sharded CI and PDF reporting.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Saikat Ganguly",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "report": "playwright show-report",
    "report:pdf": "node scripts/generate-pdf-report.js",
    "test:a11y": "playwright test --grep @a11y",
    "test:report": "node scripts/test-and-report.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.64.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dotenv": "^18.0.9",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  }
}
