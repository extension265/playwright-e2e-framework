# Copy to .env to run locally:  cp .env.example .env
#
# These are the PUBLIC demo credentials published by Sauce Demo (on its login
# page) and Restful Booker (in its API docs) — they are committed only so the
# repo runs straight after cloning. In a real project this file holds
# placeholders, real values live in a secrets manager / CI secrets, and .env is
# never committed (it is gitignored here too). CI reads these from repository
# secrets, not from this file.
#
# Pick a different file per environment with ENV_FILE, e.g.  ENV_FILE=.env.staging npx playwright test
# Variables already set in the shell always win over the file.

# ── Targets ──────────────────────────────────────────────────────────────────
UI_BASE_URL=https://www.saucedemo.com
API_BASE_URL=https://restful-booker.herokuapp.com

# ── UI credentials (Sauce Demo) ──────────────────────────────────────────────
UI_USERNAME=standard_user
UI_PASSWORD=secret_sauce # gitleaks:allow — public demo credential

# ── API credentials (Restful Booker) ─────────────────────────────────────────
API_USERNAME=admin
API_PASSWORD=password123 # gitleaks:allow — public demo credential
